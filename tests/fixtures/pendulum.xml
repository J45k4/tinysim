<mujoco model="pendulum">
  <option timestep="0.01" gravity="0 0 -9.8"/>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 0.1"/>
    <body name="link" pos="0 0 1">
      <inertial pos="0 0 -0.5" mass="2" diaginertia="0.2 0.2 0.02"/>
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom name="rod" type="capsule" size="0.05 0.5" pos="0 0 -0.5"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="drive" joint="hinge" gear="2" ctrlrange="-1 1"/>
  </actuator>
  <keyframe>
    <key name="displaced" qpos="0.25"/>
  </keyframe>
</mujoco>
